  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sb-project-auth-token",
        "description": "Supabase HttpOnly cookies อาจแบ่งเป็นหลาย chunks; browser เป็นผู้จัดการ"
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "properties": {
          "data": {},
          "meta": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "Rule": {
        "type": "object",
        "properties": {
          "field": {
            "enum": [
              "country",
              "region",
              "language",
              "adult",
              "remote",
              "hours"
            ]
          },
          "op": {
            "enum": [
              "eq",
              "in",
              "gte",
              "lte"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "field",
          "op",
          "value"
        ]
      },
      "Assessment": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "jobs",
                "skills",
                "access",
                "community"
              ]
            }
          },
          "country_code": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{2}$"
          },
          "coarse_region": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "preferred_language": {
            "enum": [
              "th",
              "en",
              null
            ]
          },
          "remote_ok": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "available_hours_week": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 168
          }
        },
        "additionalProperties": false
      },
      "Listing": {
        "type": "object",
        "properties": {
          "title_th": {
            "type": "string"
          },
          "title_en": {
            "type": "string"
          },
          "description_th": {
            "type": "string"
          },
          "description_en": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "country_code": {
            "type": "string"
          },
          "coarse_region": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "accessibility_th": {
            "type": "string"
          },
          "accessibility_en": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "job_pay_unit": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "hour",
              "day",
              "month",
              null
            ]
          },
          "job_contract": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "enum": [
                "th",
                "en"
              ]
            }
          },
          "remote": {
            "type": "boolean"
          },
          "cost_amount": {
            "type": "number",
            "minimum": 0
          },
          "capacity": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "job_pay_min": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "job_pay_max": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "rules": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "$ref": "#/components/schemas/Rule"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "title_th",
          "title_en",
          "description_th",
          "description_en",
          "category",
          "country_code",
          "languages",
          "remote",
          "cost_amount",
          "currency",
          "accessibility_th",
          "accessibility_en",
          "source_url",
          "valid_until"
        ]
      }
    }
  }
}
