      "post": {
        "summary": "ยืนยัน preview และสร้าง application/share/case/event/outbox/receipt ใน transaction เดียว",
        "responses": {
          "401": {
            "$ref": "#/components/responses/Response401"
          },
          "403": {
            "$ref": "#/components/responses/Response403"
          },
          "404": {
            "$ref": "#/components/responses/Response404"
          },
          "409": {
            "$ref": "#/components/responses/Response409"
          },
          "503": {
            "$ref": "#/components/responses/Response503"
          },
          "201": {
            "$ref": "#/components/responses/Response201"
          },
          "422": {
            "$ref": "#/components/responses/Response422"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ตรง APP_ORIGIN ของ environment; JSON≤16KiB"
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            },
            "description": "key เดิม+body เดิมคืน receipt เดิม; body เปลี่ยน409; TTL24ชั่วโมง"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "preview",
                  "hash",
                  "notice",
                  "confirmed",
                  "readback"
                ],
                "properties": {
                  "preview": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "notice": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "confirmed": {
                    "const": true
                  },
                  "readback": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
