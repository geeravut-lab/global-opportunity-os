{
  "name": "global-opportunity-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium tests/e2e",
    "test:a11y": "playwright test --project=chromium tests/a11y",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:e2e && npm run test:a11y"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "vitest": "5.1.0",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "typescript-eslint": "8.72.1",
    "@next/eslint-plugin-next": "16.4.5",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "type": "module"
}
