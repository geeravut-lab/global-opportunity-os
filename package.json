{
  "name": "global-opportunity-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && node scripts/check-design-tokens.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium tests/e2e",
    "test:a11y": "playwright test --project=chromium tests/a11y",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:e2e && npm run test:a11y",
    "db:start": "node scripts/local-stack.mjs start && node scripts/local-stack.mjs migrate && node scripts/local-stack.mjs status && node scripts/local-auth-env.mjs",
    "db:stop": "node scripts/local-stack.mjs stop",
    "db:prepare-test": "node scripts/seed-auth-fixtures.mjs",
    "test:integration": "npm run db:prepare-test && vitest run --config vitest.integration.config.ts",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "db:test:fresh": "node scripts/test-fresh-migrations.mjs",
    "check:s1": "npm run test:integration && npm run test:auth",
    "db:migrate": "node scripts/local-stack.mjs migrate",
    "db:validation:start": "node scripts/s1-validation-stack.mjs start",
    "db:validation:stop": "node scripts/s1-validation-stack.mjs stop",
    "test:validation:local": "playwright test --config playwright.validation.config.ts",
    "test:validation:hosted": "NODE_USE_ENV_PROXY=1 GOOS_VALIDATION_TARGET=hosted playwright test --config playwright.validation.config.ts",
    "test:backup-restore": "node scripts/test-backup-restore.mjs",
    "test:a11y:orca": "node scripts/test-orca-a11y.mjs",
    "db:prepare-s2": "node scripts/seed-s2-fixtures.mjs",
    "db:process-evidence": "node scripts/process-evidence.mjs",
    "test:s2": "npm run db:prepare-s2 && playwright test --config playwright.s2.config.ts",
    "dev:s2": "node scripts/s2-app.mjs dev",
    "worker:s3": "node scripts/s3-worker.mjs",
    "db:prepare-s3": "node scripts/seed-s3-fixtures.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "nodemailer": "10.3.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pg": "8.23.1",
    "supabase": "3.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "type": "module"
}
