# ค่า URL และ publishable key จาก Supabase Project ที่เจ้าของอนุมัติให้ทดสอบแล้ว (ตรวจ preflight ก่อนเปิด Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000
# เปิดหลังตั้งค่าแล้วเท่านั้น ไม่มี service_role หรือ Google Client Secret ในแอป
AUTH_ENABLED=false
AUTH_GOOGLE_ENABLED=false
# S2 ปิดตามค่าเริ่มต้น; dev:s2 เปิดกับ local runtime ให้เอง หลังใช้ migrations ที่ตรงกัน
S2_ENABLED=false
# private Realtime ใช้ transient memory token; polling ยังทำงานเมื่อ websocket ไม่พร้อม
NEXT_PUBLIC_LIVE_REALTIME=1

# S3/S4 ปิดเป็นค่าเริ่มต้น; S4 ต้องเปิด DB release gate หลัง review ด้วย
S3_ENABLED=false
S4_ENABLED=false
